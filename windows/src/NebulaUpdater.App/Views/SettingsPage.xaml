<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NebulaUpdater.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="下载设置" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="服务器地址" />
                        <TextBox x:Name="TxtBaseUrl" PlaceholderText="http://..." />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="并发线程数（1-64）" />
                        <NumberBox x:Name="NumThreads" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                    </StackPanel>

                    <ToggleSwitch x:Name="SwCleanOrphans"
                                  Header="清理清单外的旧模组"
                                  OnContent="开启"
                                  OffContent="关闭" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="TxtVersion" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="TxtBackend" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="数据目录：%USERPROFILE%\.xdyl"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />

        </StackPanel>
    </ScrollViewer>
</Page>