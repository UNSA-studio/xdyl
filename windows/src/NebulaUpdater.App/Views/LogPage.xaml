<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NebulaUpdater.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="运行日志" Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Content="打开日志文件夹" Click="OnOpenFolder" />
            <Button Content="刷新" Click="OnRefresh" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <ScrollViewer Padding="16">
                <TextBlock x:Name="TxtLog"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsTextSelectionEnabled="True"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>