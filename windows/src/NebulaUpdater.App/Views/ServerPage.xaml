<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NebulaUpdater.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="连通性检测" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模组服务器" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtServer"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="网络出口" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtWifi"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="MC 服务器" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtMc"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- Ping 进行中的旋转指示器，位于结果右侧 -->
                        <StackPanel Grid.Row="3" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8"
                                    x:Name="BusyRow" Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="检测中..." VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检测全部" Click="OnPingAll" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="提示：MC 服务器在线人数为服务端提供的值，仅供参考。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>