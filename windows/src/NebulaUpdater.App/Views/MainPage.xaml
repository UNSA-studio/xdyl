<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NebulaUpdater.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NebulaUpdater.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <!-- 目录选择卡 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="游戏目录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.ModsDirText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="选择 mods 文件夹" Click="OnPickFolder" />
                        <Button Content="自动检测" Click="OnAutoDetect" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 操作卡 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="更新模组" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ProgressBar Value="{x:Bind Vm.ProgressPercent, Mode=OneWay}"
                                 Maximum="100"
                                 Height="6" />

                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.ProgressDetail, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="开始更新"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind Vm.StartUpdateCommand}"
                                IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                        <Button Content="取消"
                                Command="{x:Bind Vm.CancelCommand}"
                                IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 日志卡 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="运行日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind Vm.LogLines}"
                              Height="260"
                              SelectionMode="None"
                              FontFamily="Consolas"
                              FontSize="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind Vm.BackendText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        </StackPanel>
    </ScrollViewer>
</Page>