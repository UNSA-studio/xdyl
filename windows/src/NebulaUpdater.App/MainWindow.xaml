<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NebulaUpdater.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NebulaUpdater.App.ViewModels"
    Title="星云更新器">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（自绘，配合 ExtendsContentIntoTitleBar） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="星云更新器" />
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="更新" Tag="main" Icon="Sync" IsSelected="True" />
                <NavigationViewItem Content="服务器" Tag="server" Icon="Globe" />
                <NavigationViewItem Content="日志" Tag="log" Icon="Document" />
            </NavigationView.MenuItems>

            <!-- Nav 内的 Frame 由代码创建并导航；这里用 Frame 承载页面 -->
            <Frame x:Name="ContentFrame" />

        </NavigationView>
    </Grid>
</Window>