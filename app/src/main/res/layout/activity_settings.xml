<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <!-- 返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="返回"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/primary_light_blue"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/primary_light_blue"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- 版本文件夹名称 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A3A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/primary_light_blue"
                    android:contentDescription="文件夹"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="Minecraft 版本文件夹名"
                    android:textColorHint="#AAFFFFFF"
                    app:hintTextColor="@color/primary_light_blue"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVersionName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1.21.1-NeoForge"
                        android:textColor="@android:color/white"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3A3A3A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- 下载线程数 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A3A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_thread"
                    android:tint="@color/primary_light_blue"
                    android:contentDescription="线程"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/threadInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="下载线程数 (20-128)"
                    android:textColorHint="#AAFFFFFF"
                    app:hintTextColor="@color/primary_light_blue"
                    app:boxBackgroundColor="@android:color/transparent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etThreadCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="256"
                        android:textColor="@android:color/white"
                        android:inputType="number"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/ivThreadInfo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/primary_light_blue"
                    android:alpha="0.7"
                    android:contentDescription="线程说明"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3A3A3A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Ping 按钮和结果显示 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A3A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_ping"
                        android:tint="@color/primary_light_blue"
                        android:contentDescription="Ping"/>

                    <Button
                        android:id="@+id/btnPingServer"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Ping (Server)"
                        android:textColor="@android:color/black"
                        app:backgroundTint="@color/primary_light_blue"
                        android:layout_marginStart="12dp"
                        android:textSize="16sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPingServerResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/primary_light_blue"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="#1E1E1E"
                    android:padding="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A3A"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_ping"
                        android:tint="@color/primary_light_blue"
                        android:contentDescription="Ping"/>

                    <Button
                        android:id="@+id/btnPingWifi"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Ping (WiFi)"
                        android:textColor="@android:color/black"
                        app:backgroundTint="@color/primary_light_blue"
                        android:layout_marginStart="12dp"
                        android:textSize="16sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPingWifiResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/primary_light_blue"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="#1E1E1E"
                    android:padding="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3A3A3A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- 扩展模式开关 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A3A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_extension"
                    android:tint="@color/primary_light_blue"
                    android:contentDescription="扩展"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swExtensionMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="扩展模式"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnExtensionPage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="进入扩展页面"
            android:textColor="@android:color/black"
            android:backgroundTint="@color/primary_light_blue"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:textSize="16sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3A3A3A"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A3A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_export"
                    android:tint="@color/primary_light_blue"
                    android:contentDescription="导出"/>

                <Button
                    android:id="@+id/btnExportLog"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="导出日志"
                    android:textColor="@android:color/black"
                    app:backgroundTint="@color/primary_light_blue"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnErrorCodes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ERROR 错误代码"
            android:textColor="@android:color/black"
            android:backgroundTint="@color/primary_light_blue"
            android:layout_marginTop="12dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="关于软件"
            android:textColor="@android:color/black"
            android:backgroundTint="@color/primary_light_blue"
            android:layout_marginTop="12dp"
            android:textSize="16sp"/>
    </LinearLayout>
</ScrollView>
