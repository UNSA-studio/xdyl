<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nebula_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:src="@drawable/ic_nebula_back"
            app:tint="@color/nebula_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="应用设置"
            android:textColor="@color/nebula_text"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志与状态"
                android:textColor="@color/nebula_text_dim"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportLog"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="导出日志"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="网络测试"
                android:textColor="@color/nebula_text_dim"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPingServer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ping (服务器)"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

            <TextView
                android:id="@+id/tvPingServerResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPingWifi"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ping (WiFi)"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

            <TextView
                android:id="@+id/tvPingWifiResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPingMcServer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ping (MC服务器)"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

            <TextView
                android:id="@+id/tvPingMcResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="更多"
                android:textColor="@color/nebula_text_dim"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtensionPage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="扩展页"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnErrorCodes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="错误代码"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="关于"
                android:textColor="@color/nebula_accent"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nebula_accent" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>