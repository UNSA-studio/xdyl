<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="Nebula updater-NU"
                    android:textColor="@color/nebula_accent"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:text="星云更新器-Android端"
                    android:textColor="@color/nebula_accent"
                    android:textSize="16sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnOpenSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:src="@drawable/ic_nebula_settings"
                app:tint="@color/nebula_accent" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_nebula_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="整合包"
                    android:src="@drawable/ic_package"
                    app:tint="@color/nebula_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="整合包状态"
                    android:textColor="@color/nebula_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPackStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="检查中…"
                android:textColor="@color/nebula_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVersionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="一键全自动更新"
            android:textColor="#FF10131A"
            android:textSize="16sp"
            app:backgroundTint="@color/nebula_accent"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_rocket"
            app:iconGravity="textStart"
            app:iconTint="#FF10131A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunch"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="启动游戏"
            android:textColor="@color/nebula_accent"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_nebula_play"
            app:iconGravity="textStart"
            app:iconTint="@color/nebula_accent"
            app:strokeColor="@color/nebula_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="最近动作"
            android:textColor="@color/nebula_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHomeLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nebula_card"
            android:minHeight="72dp"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/nebula_text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_nebula_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvQuoteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日名言"
                android:textColor="@color/nebula_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuoteChinese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="@color/nebula_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvQuoteEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvQuoteAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvQuoteAuthorEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/nebula_text_dim"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>