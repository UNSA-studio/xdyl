<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星云更新器"
            android:textColor="@color/nebula_accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nebula Updater · 整合包一键自动化"
            android:textColor="@color/nebula_text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_nebula_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="整合包状态"
                android:textColor="@color/nebula_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPackStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="检查中…"
                android:textColor="@color/nebula_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVersionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/nebula_text_dim"
                android:textSize="12sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="一键全自动更新"
            android:textColor="#FF10131A"
            android:textSize="16sp"
            app:backgroundTint="@color/nebula_accent"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_nebula_update"
            app:iconGravity="textStart"
            app:iconTint="#FF10131A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunch"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="启动游戏"
            android:textColor="@color/nebula_accent"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_nebula_play"
            app:iconGravity="textStart"
            app:iconTint="@color/nebula_accent"
            app:strokeColor="@color/nebula_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="最近动作"
            android:textColor="@color/nebula_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHomeLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nebula_card"
            android:minHeight="72dp"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/nebula_text_dim"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>