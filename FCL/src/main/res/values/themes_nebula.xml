<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 星云主题：与旧版 xdyl 一致的 Material3 深色方案（含 silver 品牌字体） -->
    <style name="Theme.Nebula" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nebula_accent</item>
        <item name="colorOnPrimary">@color/nebula_on_accent</item>
        <item name="colorPrimaryContainer">@color/nebula_container</item>
        <item name="colorOnPrimaryContainer">@color/nebula_on_container</item>
        <item name="colorSecondary">@color/nebula_accent</item>
        <item name="colorOnSecondary">@color/nebula_on_accent</item>
        <item name="colorSecondaryContainer">@color/nebula_container</item>
        <item name="colorOnSecondaryContainer">@color/nebula_on_container</item>
        <item name="android:colorBackground">@color/nebula_bg</item>
        <item name="colorSurface">@color/nebula_bg</item>
        <item name="colorOnSurface">@color/nebula_text</item>
        <item name="colorSurfaceVariant">@color/nebula_card</item>
        <item name="android:statusBarColor">@color/nebula_bg</item>
        <item name="android:navigationBarColor">@color/nebula_bg</item>
        <item name="android:fontFamily">@font/silver</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>